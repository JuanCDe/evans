# Only public project files. Local data, exports and generated output stay out.
/*
!/.gitignore
!/LICENSE
!/README.md
!/package.json

!/extension/
/extension/*
!/extension/*.js
!/extension/*.html
!/extension/manifest.json
!/extension/assets/
/extension/assets/*
!/extension/assets/icon*.png
!/extension/assets/mark.svg
!/extension/core/
/extension/core/*
!/extension/core/*.js
!/extension/ui/
/extension/ui/*
!/extension/ui/*.js
!/extension/ui/*.css

!/scripts/
/scripts/*
!/scripts/*.mjs
!/scripts/render-icons.pw

!/tests/
/tests/*
!/tests/*.mjs
!/tests/*.pw
