async (page) => {
  const assert = (value, message) => { if (!value) throw new Error(message); };
  const rpc = (type, data = {}) => page.evaluate(async ({type,data}) => {
    const r = await chrome.runtime.sendMessage({type,...data});
    if (!r?.ok) throw new Error(r?.error || 'RPC failed'); return r.data;
  }, {type,data});
  const read = (store, index, key) => page.evaluate(async ({store,index,key}) => (await import('./core/db.js')).all(store,index,key),{store,index,key});
  const waitRun = async id => {
    for (let attempt=0;attempt<250;attempt++) {
      const run=(await read('runs')).find(r=>r.id===id);
      if(run && run.status!=='running') break;
      await page.waitForTimeout(200);
    }
    return (await read('runs')).find(r=>r.id===id);
  };
  const errors=[]; page.on('pageerror',e=>errors.push(e.message));
  const original = await rpc('STATUS');
  assert(original.pages.length === 0, 'New workspace must have no monitored pages');
  assert((await read('changes')).length === 0, 'New workspace must have no change history');
  await rpc('SETTINGS',{patch:{paused:true,theme:'light'}});
  await page.evaluate(()=>fetch('http://127.0.0.1:4174/control?v=1'));
  await page.locator('.heading-actions').getByRole('button',{name:'Add pages',exact:true}).click();
  await page.locator('#bulk-urls').fill('Static test | http://127.0.0.1:4174/static\nDynamic test | http://127.0.0.1:4174/dynamic\nEmpty test | http://127.0.0.1:4174/empty\nError test | http://127.0.0.1:4174/error\nDuplicate | http://127.0.0.1:4174/static#jobs');
  await page.locator('#add-form select[name="mode"]').selectOption('fetch');
  assert((await page.locator('#bulk-feedback').textContent()).includes('4 new · 1 duplicates'),'Bulk preview should deduplicate');
  await page.locator('#add-submit').click();
  await page.waitForFunction(()=>!document.querySelector('dialog').open);
  const added=(await rpc('STATUS')).pages.filter(p=>p.url.startsWith('http://127.0.0.1:4174'));
  assert(added.length===4,'Bulk add should save 4 pages');
  const dynamic=added.find(p=>p.name==='Dynamic test'), stat=added.find(p=>p.name==='Static test');
  await rpc('UPDATE_PAGE',{page:{...dynamic,mode:'rendered',selector:'#jobs'}});
  await rpc('UPDATE_PAGE',{page:{...stat,selector:'#jobs'}});
  const first=await rpc('RUN',{ids:added.map(p=>p.id)});
  const duplicate=await rpc('RUN',{ids:[stat.id]});
  assert(first.id===duplicate.id,'Concurrent requests must share one active pass');
  const firstResult=await waitRun(first.id);
  assert(firstResult.completed===4&&firstResult.errors===2&&firstResult.changed===0,'First pass must baseline two pages and record two errors');
  const firstChecks=await read('checks','runId',first.id);
  assert(firstChecks.filter(c=>c.status==='baseline').length===2,'Expected two initial baselines');
  const snapshots=await read('snapshots');
  assert(snapshots.find(s=>s.id===dynamic.id).text.includes('Engineer Madrid'),'Rendered mode must wait for JavaScript');
  assert(!snapshots.find(s=>s.id===stat.id).text.includes('Hidden job'),'Hidden text must be excluded');
  assert(!snapshots.find(s=>s.id===stat.id).text.includes('Navigation'),'Selected zone must exclude navigation');
  const resources=await page.evaluate(async()=>(await fetch('http://127.0.0.1:4174/stats')).json());
  assert(resources.tracking===0,'Quick HTML parsing must not load remote image resources');
  await page.evaluate(()=>fetch('http://127.0.0.1:4174/control?v=2'));
  const second=await rpc('RUN',{ids:[stat.id,dynamic.id]});
  const secondResult=await waitRun(second.id);
  assert(secondResult.changed===2&&secondResult.errors===0,'Second pass must detect both changes');
  const newChanges=await read('changes','runId',second.id);
  assert(newChanges.length===2,'Both exact comparisons must be stored');
  assert(newChanges.find(c=>c.pageId===stat.id).after.includes('Product Designer'),'Saved diff must include new job');
  const notifications=await page.evaluate(()=>chrome.notifications.getAll());
  assert(newChanges.every(c=>Object.hasOwn(notifications,c.id)),'Each changed page must create its own notification');
  const third=await rpc('RUN',{ids:[stat.id,dynamic.id]});
  assert((await waitRun(third.id)).changed===0,'Identical content must not notify again');
  const current=(await rpc('STATUS')).pages.find(p=>p.id===stat.id);
  await rpc('UPDATE_PAGE',{page:{...current,keywords:['Developer'],keywordMode:'added'}});
  await page.evaluate(()=>fetch('http://127.0.0.1:4174/control?v=1'));
  const fourth=await rpc('RUN',{ids:[stat.id]});await waitRun(fourth.id);
  assert((await read('checks','runId',fourth.id))[0].status==='filtered','Non-matching changes should be filtered');
  assert((await read('changes','runId',fourth.id))[0].filtered,'Filtered comparisons must remain auditable');
  await page.getByRole('link',{name:/Changes/}).click();
  await page.getByRole('heading',{name:'Changes',exact:true}).waitFor();
  await page.screenshot({path:'output/playwright/changes-desktop.png',fullPage:true});
  await page.getByRole('button',{name:'Changes only',exact:true}).click();
  assert(await page.locator('.diff-content ins,.diff-content del').count()>0,'Comparison must highlight changes');
  await page.getByRole('link',{name:'Runs',exact:true}).click();
  await page.locator('.pass-result').first().waitFor();
  await page.screenshot({path:'output/playwright/runs-desktop.png',fullPage:true});
  await page.getByRole('link',{name:'Settings',exact:true}).click();
  await page.locator('#concurrency').selectOption('3');
  await page.getByRole('button',{name:'Save settings',exact:true}).click();
  assert((await rpc('STATUS')).settings.concurrency===3,'Settings must persist');
  await page.screenshot({path:'output/playwright/settings-desktop.png',fullPage:true});
  await page.getByRole('button',{name:'Toggle theme',exact:true}).click();
  assert((await rpc('STATUS')).settings.theme==='dark','Dark theme must persist');
  await page.screenshot({path:'output/playwright/dark-desktop.png',fullPage:true});
  await page.getByRole('button',{name:'Toggle theme',exact:true}).click();
  await page.setViewportSize({width:390,height:844});
  await page.getByRole('link',{name:/Pages/}).click();
  await page.screenshot({path:'output/playwright/pages-mobile.png',fullPage:true});
  assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1),'Mobile document must not overflow horizontally');
  await page.getByRole('link',{name:/Changes/}).click();
  await page.screenshot({path:'output/playwright/changes-mobile.png',fullPage:true});
  assert(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1),'Mobile findings must not overflow horizontally');
  await page.setViewportSize({width:1440,height:1000});
  await page.reload();
  assert((await rpc('STATUS')).pages.length===4,'Pages must survive reload');
  assert((await read('runs')).length===4,'Every pass must persist');
  await rpc('READ',{ids:newChanges.map(c=>c.id)});
  assert((await read('changes','runId',second.id)).every(c=>c.read),'Read state must persist');
  await rpc('DELETE',{ids:added.map(p=>p.id)});
  assert((await rpc('STATUS')).pages.length===0,'Deleting pages must leave an empty watch list');
  assert(!(await read('checks')).some(c=>added.some(p=>p.id===c.pageId)),'Deleting a page must remove its check history');

  await rpc('ADD',{pages:[{name:'Carousel test',url:'http://127.0.0.1:4174/carousel',mode:'rendered'}]});
  const carousel=(await rpc('STATUS')).pages[0];
  await page.evaluate(async ({id,configVersion})=>{
    const {put}=await import('./core/db.js');
    await put('snapshots',{id,configVersion,timestamp:Date.now(),text:'Open positions\n\nRemote-first engineering team'});
  },carousel);
  const checkCarousel=async version=>{
    await page.evaluate(v=>fetch('http://127.0.0.1:4174/control?v='+v),version);
    const run=await rpc('RUN',{ids:[carousel.id]});
    await waitRun(run.id);
    return (await read('checks','runId',run.id))[0];
  };
  assert((await checkCarousel(1)).status==='baseline','Legacy carousel capture must migrate without an alert');
  const carouselText=(await read('snapshots')).find(s=>s.id===carousel.id).text;
  assert(carouselText.match(/Engineer in Madrid/g)?.length===1&&!carouselText.includes('Excluded auxiliary text'),'Capture must keep the inactive original, skip clones, and respect unrelated aria-hidden text');
  assert((await checkCarousel(2)).status==='unchanged','Rotating the active slide must not create a change');
  assert((await checkCarousel(3)).status==='changed','Editing a slide must still create a change');
  const carouselChanges=await read('changes','pageId',carousel.id);
  assert(carouselChanges.length===1&&carouselChanges[0].after.includes('Senior Engineer in Madrid'),'Only the genuine edit must appear in history');
  await rpc('DELETE',{ids:[carousel.id]});

  await rpc('SETTINGS',{patch:{paused:false,concurrency:2}});
  assert(errors.length===0,'No page exceptions: '+errors.join('; '));
  return {ok:true,passes:7,checks:12,coverage:['bulk add','deduplication','static fetch','hydrated JavaScript','baselines','exact diff','per-page notifications','error handling','keyword filters','pass history','settings','themes','responsive layouts','persistence','read state','cascade delete','carousel rotation and edits']};
}
