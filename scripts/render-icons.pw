async page => {
  await page.goto('http://127.0.0.1:4173');
  for (const size of [16,32,48,128]) {
    const download = page.waitForEvent('download');
    await page.evaluate(async size => {
      const mark = await (await fetch('assets/mark.svg')).text();
      const inner = mark.replace(/<svg[^>]*>/,'').replace('</svg>','');
      const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${size*4}" height="${size*4}" viewBox="0 0 40 40"><rect width="40" height="40" rx="9" fill="#71365e"/><g transform="translate(4 4)" color="#fff" fill="none">${inner}</g></svg>`;
      const img = new Image();img.src = URL.createObjectURL(new Blob([svg],{type:'image/svg+xml'}));await img.decode();
      const canvas = document.createElement('canvas');canvas.width=size;canvas.height=size;
      const ctx=canvas.getContext('2d');ctx.imageSmoothingQuality='high';ctx.drawImage(img,0,0,size,size);URL.revokeObjectURL(img.src);
      const a=document.createElement('a');a.download=`icon${size}.png`;a.href=canvas.toDataURL();a.click();
    },size);
    await (await download).saveAs(`extension/assets/icon${size}.png`);
  }
  return {icons:[16,32,48,128]};
}
